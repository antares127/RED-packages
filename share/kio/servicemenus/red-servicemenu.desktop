[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/x-red;application/x-ared;inode/directory;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/gzip;application/x-xz;application/x-tar;application/zstd;application/x-zstd;application/vnd.debian.binary-package;application/x-rpm;
Actions=openWithRed;
X-KDE-Priority=TopLevel
Icon=red

[Desktop Action openWithRed]
Name=使用 RED 打开
Name[en]=Open with RED
Icon=red
Exec=red -gui %f
